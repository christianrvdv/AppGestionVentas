{% extends 'base.html.twig' %}

{% block title %}Dashboard · Gestión de Negocio{% endblock %}

{% set status_labels = {
    'OPEN': 'Abierta',
    'PARTIAL': 'Parcial',
    'RECOVERED': 'Recuperada',
    'CLOSED': 'Cerrada',
    'CANCELLED': 'Cancelada'
} %}

{# EXCEPCIÓN super_admin (ADR-0016): sin tenant activo el controller
   envía totales en cero. Se detecta sin tocar el controller: rol
   global + todo vacío. Un tenant real nunca cumple las dos cosas. #}
{% set super_admin_sin_negocio = app.user is not null
    and app.user.isSuperAdmin
    and totals.totalInvestment == '0.00'
    and active_investments is empty
    and usd_rate is null %}

{% block body %}
    <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
        <h1 class="heading-1">Dashboard</h1>

        {# Estado vivo del día (lo que el operador consulta a diario),
           separado del consolidado histórico de abajo. #}
        {% if usd_rate %}
            <div class="text-end">
                <p class="small-text">Tasa USD vigente</p>
                <p class="heading-3 tabular-nums">
                    {{ usd_rate.rate|number_format(4, ',', '.') }}
                    <span class="small-text">({{ usd_rate.rateDate|date('d/m/Y') }})</span>
                </p>
            </div>
        {% else %}
            <span class="badge badge-warning">Tasa USD sin registrar</span>
        {% endif %}
    </div>

    {% if super_admin_sin_negocio %}
        <div class="alert alert-warning" role="alert">
            <p class="font-medium">Sin negocio activo</p>
            <p>Estás viendo el dashboard como super administrador sin un negocio seleccionado, así que no hay datos que consolidar. El panel de administración sustituirá esta vista.</p>
        </div>
    {% else %}
        <section aria-labelledby="titulos-totales" class="mb-8">
            <h2 id="titulos-totales" class="heading-2 mb-4">Resumen histórico</h2>

            <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                <li class="card">
                    <p class="small-text">Total invertido</p>
                    <p class="mt-1 heading-1 tabular-nums">{{ totals.totalInvestment|number_format(2, ',', '.') }}</p>
                </li>
                <li class="card">
                    <p class="small-text">Total recuperado</p>
                    <p class="mt-1 heading-1 tabular-nums">{{ totals.totalRecovered|number_format(2, ',', '.') }}</p>
                </li>
                <li class="card">
                    <p class="small-text">Total pendiente</p>
                    <p class="mt-1 heading-1 tabular-nums">{{ totals.totalPending|number_format(2, ',', '.') }}</p>
                </li>
                <li class="card">
                    <p class="small-text">Ganancia bruta</p>
                    <p class="mt-1 heading-1 tabular-nums">{{ totals.totalGrossProfit|number_format(2, ',', '.') }}</p>
                </li>
                <li class="card">
                    <p class="small-text">Ganancia reconocida</p>
                    <p class="mt-1 heading-1 tabular-nums">{{ totals.totalRecognizedProfit|number_format(2, ',', '.') }}</p>
                </li>
            </ul>
        </section>

        <section aria-labelledby="titulos-inversiones" class="mb-8">
            <h2 id="titulos-inversiones" class="heading-2 mb-4">Inversiones activas</h2>

            {% if active_investments is empty %}
                <div class="empty-state">
                    No hay inversiones activas. Cuando registres una inversión, aparecerá aquí.
                </div>
            {% else %}
                <div class="overflow-x-auto rounded border border-border bg-surface">
                    <table class="table">
                        <caption class="sr-only">Inversiones en estado abierta o parcial</caption>
                        <thead>
                            <tr class="table-header">
                                <th scope="col" class="px-4 py-2 text-start font-medium">Código</th>
                                <th scope="col" class="px-4 py-2 text-start font-medium">Fecha</th>
                                <th scope="col" class="px-4 py-2 text-start font-medium">Estado</th>
                                <th scope="col" class="px-4 py-2 text-end font-medium">Total</th>
                                <th scope="col" class="px-4 py-2 text-end font-medium"><span class="sr-only">Detalle</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for investment in active_investments %}
                                <tr class="table-row">
                                    <td class="px-4 py-2 font-medium text-foreground">{{ investment.code }}</td>
                                    <td class="px-4 py-2 text-foreground">{{ investment.investmentDate|date('d/m/Y') }}</td>
                                    <td class="px-4 py-2">
                                        {% if investment.status == 'OPEN' %}
                                            <span class="badge badge-success">Abierta</span>
                                        {% elseif investment.status == 'PARTIAL' %}
                                            <span class="badge badge-warning">Parcial</span>
                                        {% else %}
                                            <span class="muted-text">{{ status_labels[investment.status] ?? investment.status }}</span>
                                        {% endif %}
                                    </td>
                                    <td class="px-4 py-2 text-end tabular-nums text-foreground">{{ investment.totalInvestment|number_format(2, ',', '.') }}</td>
                                    <td class="px-4 py-2 text-end">
                                        <a
                                            href="{{ path('app_investment_show', {id: investment.id}) }}"
                                            class="link"
                                        >Ver detalle</a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </section>

        <section aria-labelledby="titulos-proximamente">
            <h2 id="titulos-proximamente" class="heading-2 mb-4">Próximamente</h2>
            <p class="empty-state">
                Gráficos de evolución y comparativas entre períodos estarán disponibles en una próxima versión.
            </p>
        </section>
    {% endif %}
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Configuración · Gestión de Negocio{% endblock %}

{% block body %}
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <h1 class="heading-1">Configuración del tenant</h1>
        <p class="muted-text">Tenant: {{ tenant.name }} ({{ tenant.slug }})</p>
    </div>

    {{ form_start(form, {attr: {class: 'space-y-8', novalidate: 'novalidate'}}) }}

        {# SECCIÓN: NEGOCIO #}
        <section class="card p-6" aria-labelledby="seccion-negocio">
            <h2 id="seccion-negocio" class="heading-2 mb-4">Negocio</h2>

            <div class="space-y-6">
                <div>
                    <label for="{{ form.tenant_name.vars.id }}" class="form-label">{{ form.tenant_name.vars.label }}</label>
                    {{ form_widget(form.tenant_name, {attr: {class: 'input'}}) }}
                    {% for error in form.tenant_name.vars.errors %}
                        <p class="form-error" role="alert">{{ error.message }}</p>
                    {% endfor %}
                </div>

                <div>
                    <label for="{{ form.tenant_slug.vars.id }}" class="form-label">{{ form.tenant_slug.vars.label }}</label>
                    {{ form_widget(form.tenant_slug, {attr: {class: 'input bg-muted/50'}}) }}
                    {% if form.tenant_slug.vars.help is defined %}
                        <p class="form-help">{{ form.tenant_slug.vars.help }}</p>
                    {% endif %}
                </div>
            </div>
        </section>

        {# SECCIÓN: MONEDA #}
        <section class="card p-6" aria-labelledby="seccion-moneda">
            <h2 id="seccion-moneda" class="heading-2 mb-4">Moneda</h2>

            <div class="grid gap-6 md:grid-cols-2">
                <div>
                    <label for="{{ form.base_currency.vars.id }}" class="form-label">{{ form.base_currency.vars.label }}</label>
                    {{ form_widget(form.base_currency, {attr: {class: 'input'}}) }}
                    {% for error in form.base_currency.vars.errors %}
                        <p class="form-error" role="alert">{{ error.message }}</p>
                    {% endfor %}
                    {% if form.base_currency.vars.help is defined %}
                        <p class="form-help">{{ form.base_currency.vars.help }}</p>
                    {% endif %}
                </div>

                <div>
                    <label for="{{ form.currency_scale.vars.id }}" class="form-label">{{ form.currency_scale.vars.label }}</label>
                    {{ form_widget(form.currency_scale, {attr: {class: 'input'}}) }}
                    {% for error in form.currency_scale.vars.errors %}
                        <p class="form-error" role="alert">{{ error.message }}</p>
                    {% endfor %}
                    {% if form.currency_scale.vars.help is defined %}
                        <p class="form-help">{{ form.currency_scale.vars.help }}</p>
                    {% endif %}
                </div>
            </div>
        </section>

        {# SECCIÓN: MÁRGENES #}
        <section class="card p-6" aria-labelledby="seccion-margenes">
            <h2 id="seccion-margenes" class="heading-2 mb-4">Márgenes</h2>

            <div>
                <label for="{{ form.default_margin_pct.vars.id }}" class="form-label">{{ form.default_margin_pct.vars.label }}</label>
                {{ form_widget(form.default_margin_pct, {attr: {class: 'input'}}) }}
                {% for error in form.default_margin_pct.vars.errors %}
                    <p class="form-error" role="alert">{{ error.message }}</p>
                {% endfor %}
                {% if form.default_margin_pct.vars.help is defined %}
                    <p class="form-help">{{ form.default_margin_pct.vars.help }}</p>
                {% endif %}
            </div>
        </section>

        {# SECCIÓN: RECUPERACIÓN #}
        <section class="card p-6" aria-labelledby="seccion-recuperacion">
            <h2 id="seccion-recuperacion" class="heading-2 mb-4">Recuperación</h2>

            <div>
                <label for="{{ form.recovery_mode.vars.id }}" class="form-label">{{ form.recovery_mode.vars.label }}</label>
                {{ form_widget(form.recovery_mode, {attr: {class: 'input'}}) }}
                {% for error in form.recovery_mode.vars.errors %}
                    <p class="form-error" role="alert">{{ error.message }}</p>
                {% endfor %}
                {% if form.recovery_mode.vars.help is defined %}
                    <p class="form-help">{{ form.recovery_mode.vars.help }}</p>
                {% endif %}
            </div>
        </section>

        {# SECCIÓN: USD #}
        <section class="card p-6" aria-labelledby="seccion-usd">
            <h2 id="seccion-usd" class="heading-2 mb-4">USD</h2>

            <div class="flex items-start gap-3">
                {{ form_widget(form.usd_control_enabled) }}
                <div class="mt-1">
                    <label for="{{ form.usd_control_enabled.vars.id }}" class="form-label">{{ form.usd_control_enabled.vars.label }}</label>
                    {% for error in form.usd_control_enabled.vars.errors %}
                        <p class="form-error" role="alert">{{ error.message }}</p>
                    {% endfor %}
                    {% if form.usd_control_enabled.vars.help is defined %}
                        <p class="form-help">{{ form.usd_control_enabled.vars.help }}</p>
                    {% endif %}
                </div>
            </div>
        </section>

        {# BOTONES #}
        <hr class="divider">
        <div class="flex gap-3">
            <button type="submit" class="btn-primary">Guardar configuración</button>
        </div>

    {{ form_end(form) }}
{% endblock %}

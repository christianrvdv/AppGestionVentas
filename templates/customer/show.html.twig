{% extends 'base.html.twig' %}

{% block title %}{{ customer.name }} · Gestión de Negocio{% endblock %}

{% block body %}
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <h1 class="text-2xl font-semibold text-foreground">
            {{ customer.name }}
            <span class="ml-2 align-middle text-sm font-normal {{ customer.isActive ? 'text-muted' : 'text-danger' }}">
                {{ customer.isActive ? 'Activo' : 'Inactivo' }}
            </span>
        </h1>
        <div class="flex flex-wrap items-center gap-4">
            <a href="{{ path('app_customer_edit', {id: customer.id}) }}" class="text-sm text-brand hover:underline">Editar</a>
            <a href="{{ path('app_payment_new') }}" class="text-sm text-brand hover:underline">Registrar pago a cuenta</a>
            <a href="{{ path('app_customer_index') }}" class="text-sm text-brand hover:underline">Volver al listado</a>
        </div>
    </div>

    <section aria-labelledby="titulos-saldo" class="mb-10">
        <h2 id="titulos-saldo" class="mb-4 text-lg font-medium text-foreground">Saldo</h2>
        <dl class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <div class="rounded border border-border bg-surface p-4">
                <dt class="text-sm text-muted">Total vendido</dt>
                <dd id="cliente-total-vendido" class="mt-1 text-foreground">{{ total_sales|number_format(2, ',', '.') }}</dd>
            </div>
            <div class="rounded border border-border bg-surface p-4">
                <dt class="text-sm text-muted">Total pagado</dt>
                <dd id="cliente-total-pagado" class="mt-1 text-foreground">{{ total_paid|number_format(2, ',', '.') }}</dd>
            </div>
            <div class="rounded border border-border bg-surface p-4">
                <dt class="text-sm text-muted">Saldo pendiente</dt>
                <dd id="cliente-saldo" class="mt-1 text-xl font-semibold text-foreground">{{ balance|number_format(2, ',', '.') }}</dd>
            </div>
            <div class="rounded border border-border bg-surface p-4">
                <dt class="text-sm text-muted">Anticipos (a cuenta)</dt>
                <dd id="cliente-anticipos" class="mt-1 text-foreground">{{ advances|number_format(2, ',', '.') }}</dd>
            </div>
        </dl>
        <p class="mt-3 text-sm text-muted">
            El saldo pendiente es lo vendido (sin ventas anuladas) menos lo pagado: puede ser negativo si el cliente
            adelantó más de lo que compró. Los anticipos son pagos sin venta asociada.
        </p>
    </section>

    <section aria-labelledby="titulos-datos" class="mb-10">
        <h2 id="titulos-datos" class="mb-4 text-lg font-medium text-foreground">Datos</h2>
        <dl class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            <div class="rounded border border-border bg-surface p-4">
                <dt class="text-sm text-muted">Teléfono</dt>
                <dd class="mt-1 text-foreground">{{ customer.phone ?? '—' }}</dd>
            </div>
            <div class="rounded border border-border bg-surface p-4">
                <dt class="text-sm text-muted">Email</dt>
                <dd class="mt-1 text-foreground">{{ customer.email ?? '—' }}</dd>
            </div>
            <div class="rounded border border-border bg-surface p-4">
                <dt class="text-sm text-muted">Dirección</dt>
                <dd class="mt-1 text-foreground">{{ customer.address ?? '—' }}</dd>
            </div>
            <div class="rounded border border-border bg-surface p-4 sm:col-span-2 lg:col-span-3">
                <dt class="text-sm text-muted">Notas</dt>
                <dd class="mt-1 text-foreground">{{ customer.notes ?? '—' }}</dd>
            </div>
        </dl>
    </section>

    <section aria-labelledby="titulos-ventas" class="mb-10">
        <h2 id="titulos-ventas" class="mb-4 text-lg font-medium text-foreground">Ventas</h2>
        {% if sales is empty %}
            <p class="rounded border border-border bg-surface px-4 py-3 text-sm text-muted">Este cliente no tiene ventas registradas.</p>
        {% else %}
            <div class="overflow-x-auto rounded border border-border bg-surface">
                <table class="w-full text-sm">
                    <caption class="sr-only">Ventas de {{ customer.name }}</caption>
                    <thead>
                        <tr class="border-b border-border text-start text-muted">
                            <th scope="col" class="px-4 py-2 text-start font-medium">Fecha</th>
                            <th scope="col" class="px-4 py-2 text-start font-medium">Venta</th>
                            <th scope="col" class="px-4 py-2 text-start font-medium">Inversión</th>
                            <th scope="col" class="px-4 py-2 text-end font-medium">Total</th>
                            <th scope="col" class="px-4 py-2 text-end font-medium"><span class="sr-only">Detalle</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for sale in sales %}
                            <tr class="border-b border-border last:border-b-0">
                                <td class="px-4 py-2 text-foreground">{{ sale.saleDate|date('d/m/Y') }}</td>
                                <td class="px-4 py-2">Venta {{ sale.id }}</td>
                                <td class="px-4 py-2">
                                    <a
                                        href="{{ path('app_investment_show', {id: sale.investment.id}) }}"
                                        class="text-brand hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand"
                                    >{{ sale.investment.code }}</a>
                                </td>
                                <td class="px-4 py-2 text-end">{{ sale.totalAmount|number_format(2, ',', '.') }}</td>
                                <td class="px-4 py-2 text-end">
                                    <a
                                        href="{{ path('app_sale_show', {id: sale.id}) }}"
                                        class="text-brand hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand"
                                    >Ver detalle</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>

    <section aria-labelledby="titulos-pagos" class="mb-10">
        <h2 id="titulos-pagos" class="mb-4 text-lg font-medium text-foreground">Pagos</h2>
        {% if payments.items is empty %}
            <p class="rounded border border-border bg-surface px-4 py-3 text-sm text-muted">Este cliente no tiene pagos registrados.</p>
        {% else %}
            <div class="overflow-x-auto rounded border border-border bg-surface">
                <table class="w-full text-sm">
                    <caption class="sr-only">Pagos de {{ customer.name }}</caption>
                    <thead>
                        <tr class="border-b border-border text-start text-muted">
                            <th scope="col" class="px-4 py-2 text-start font-medium">Fecha</th>
                            <th scope="col" class="px-4 py-2 text-start font-medium">Venta</th>
                            <th scope="col" class="px-4 py-2 text-start font-medium">Método</th>
                            <th scope="col" class="px-4 py-2 text-end font-medium">Monto</th>
                            <th scope="col" class="px-4 py-2 text-start font-medium">Referencia</th>
                            <th scope="col" class="px-4 py-2 text-start font-medium">Notas</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for payment in payments %}
                            <tr class="border-b border-border last:border-b-0">
                                <td class="px-4 py-2 text-foreground">{{ payment.paymentDate|date('d/m/Y') }}</td>
                                <td class="px-4 py-2">
                                    {% if payment.sale %}
                                        <a
                                            href="{{ path('app_sale_show', {id: payment.sale.id}) }}"
                                            class="text-brand hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand"
                                        >Venta {{ payment.sale.id }}</a>
                                    {% else %}
                                        <span class="text-muted">A cuenta</span>
                                    {% endif %}
                                </td>
                                <td class="px-4 py-2">{{ methods[payment.method] ?? payment.method }}</td>
                                <td class="px-4 py-2 text-end">{{ payment.amount|number_format(2, ',', '.') }}</td>
                                <td class="px-4 py-2">{{ payment.reference ?? '—' }}</td>
                                <td class="px-4 py-2">{{ payment.notes ?? '—' }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <nav aria-label="Paginación de pagos del cliente" class="mt-4">
                {{ knp_pagination_render(payments) }}
            </nav>
        {% endif %}
    </section>
{% endblock %}

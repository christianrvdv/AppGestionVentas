{% extends 'base.html.twig' %}

{% block title %}Clientes · Gestión de Negocio{% endblock %}

{% block body %}
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <h1 class="heading-1">Clientes</h1>
        <a href="{{ path('app_customer_new') }}" class="btn-primary">Nuevo cliente</a>
    </div>

    <form method="get" action="{{ path('app_customer_index') }}" class="mb-6 flex flex-wrap items-end gap-3">
        <div>
            <label for="q" class="form-label">Buscar clientes</label>
            <input
                type="search"
                id="q"
                name="q"
                value="{{ q ?? '' }}"
                maxlength="100"
                placeholder="Nombre, teléfono o email"
                class="input"
            >
        </div>
        {# "Nuevo cliente" (cabecera) es la única primaria de la vista
           (DESIGN.md §8.7); Buscar/Limpiar son acciones de la vista. #}
        <button type="submit" class="btn-secondary">Buscar</button>
        {% if q %}
            <a href="{{ path('app_customer_index') }}" class="btn-ghost">Limpiar filtro</a>
        {% endif %}
    </form>

    {% if pagination.items is empty %}
        <div class="empty-state">
            {% if q %}
                No hay clientes que coincidan con "{{ q }}".
            {% else %}
                Todavía no hay clientes.
                <a href="{{ path('app_customer_new') }}" class="link">Crear el primero</a>.
            {% endif %}
        </div>
    {% else %}
        <div class="overflow-x-auto rounded border border-border bg-surface">
            <table class="table">
                <caption class="sr-only">Listado de clientes del negocio</caption>
                <thead>
                    <tr class="table-header">
                        <th scope="col" class="px-4 py-2 text-start font-medium">Nombre</th>
                        <th scope="col" class="px-4 py-2 text-start font-medium">Teléfono</th>
                        <th scope="col" class="px-4 py-2 text-start font-medium">Email</th>
                        <th scope="col" class="px-4 py-2 text-start font-medium">Estado</th>
                        <th scope="col" class="px-4 py-2 text-end font-medium"><span class="sr-only">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    {% for customer in pagination %}
                        <tr class="table-row {{ customer.isActive ? '' : 'text-muted' }}">
                            <td class="px-4 py-2 font-medium text-foreground">{{ customer.name }}</td>
                            <td class="px-4 py-2 tabular-nums">{{ customer.phone ?? '—' }}</td>
                            <td class="px-4 py-2">{{ customer.email ?? '—' }}</td>
                            <td class="px-4 py-2">
                                <span class="badge {{ customer.isActive ? 'badge-success' : 'badge-danger' }}">
                                    {{ customer.isActive ? 'Activo' : 'Inactivo' }}
                                </span>
                            </td>
                            <td class="px-4 py-2">
                                <div class="flex items-center justify-end gap-3">
                                    <a
                                        href="{{ path('app_customer_show', {id: customer.id}) }}"
                                        class="link"
                                    >Ver detalle</a>
                                    <a
                                        href="{{ path('app_customer_edit', {id: customer.id}) }}"
                                        class="link"
                                    >Editar</a>
                                    {% if customer.isActive %}
                                        <form
                                            method="post"
                                            action="{{ path('app_customer_deactivate', {id: customer.id}) }}"
                                        >
                                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                                            <button type="submit" class="link text-danger">Desactivar</button>
                                        </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <nav aria-label="Paginación de clientes" class="mt-4">
            {{ knp_pagination_render(pagination) }}
        </nav>
    {% endif %}
{% endblock %}

{# Formulario de cliente. Mismo patrón que product/_form.html.twig:
   label + input + help + error, y fila de acciones tras un divider
   (convención de Fase 2: settings/index y usd_rate/new). #}
{{ form_start(form, {attr: {class: 'space-y-6'}}) }}
    <div>
        <label for="{{ form.name.vars.id }}" class="form-label">{{ form.name.vars.label }}</label>
        {{ form_widget(form.name, {attr: {class: 'input w-full'}}) }}
        {% for error in form.name.vars.errors %}
            <p class="form-error" role="alert">{{ error.message }}</p>
        {% endfor %}
    </div>

    <div>
        <label for="{{ form.phone.vars.id }}" class="form-label">{{ form.phone.vars.label }}</label>
        {{ form_widget(form.phone, {attr: {class: 'input w-full'}}) }}
        {% for error in form.phone.vars.errors %}
            <p class="form-error" role="alert">{{ error.message }}</p>
        {% endfor %}
        <p class="form-help">Opcional. No puede repetirse con otro cliente del mismo negocio.</p>
    </div>

    <div>
        <label for="{{ form.email.vars.id }}" class="form-label">{{ form.email.vars.label }}</label>
        {{ form_widget(form.email, {attr: {class: 'input w-full'}}) }}
        {% for error in form.email.vars.errors %}
            <p class="form-error" role="alert">{{ error.message }}</p>
        {% endfor %}
        <p class="form-help">Opcional. No puede repetirse con otro cliente del mismo negocio.</p>
    </div>

    <div>
        <label for="{{ form.address.vars.id }}" class="form-label">{{ form.address.vars.label }}</label>
        {{ form_widget(form.address, {attr: {class: 'input w-full'}}) }}
        {% for error in form.address.vars.errors %}
            <p class="form-error" role="alert">{{ error.message }}</p>
        {% endfor %}
    </div>

    <div>
        <label for="{{ form.notes.vars.id }}" class="form-label">{{ form.notes.vars.label }}</label>
        {{ form_widget(form.notes, {attr: {class: 'input w-full', rows: 4}}) }}
        {% for error in form.notes.vars.errors %}
            <p class="form-error" role="alert">{{ error.message }}</p>
        {% endfor %}
    </div>

    <div class="flex items-start gap-3">
        {{ form_widget(form.isActive) }}
        <div class="mt-1">
            <label for="{{ form.isActive.vars.id }}" class="form-label">{{ form.isActive.vars.label }}</label>
            {% for error in form.isActive.vars.errors %}
                <p class="form-error" role="alert">{{ error.message }}</p>
            {% endfor %}
            <p class="form-help">Los clientes inactivos no aparecen al registrar ventas ni pagos; su historial se conserva.</p>
        </div>
    </div>

    {{ form_rest(form) }}
    <hr class="divider">
    <div class="flex gap-3">
        <button type="submit" class="btn-primary">{{ submit_label|default('Guardar') }}</button>
        <a href="{{ path('app_customer_index') }}" class="btn-secondary">Cancelar</a>
    </div>
{{ form_end(form) }}

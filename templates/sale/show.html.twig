{% extends 'base.html.twig' %}

{% block title %}Venta {{ sale.id }} · Gestión de Negocio{% endblock %}

{% block body %}
    {# Los totales se derivan en vivo desde las líneas y las allocations:
       la cabecera (Sale.totalAmount) se materializa al crear la venta, pero
       la ganancia bruta y la reconocida son sumas de las líneas y no hay
       columna que las guarde. Pagado y pendiente también se calculan: desde
       ADR-0018 "pagado" es la suma de las allocations, no la de los pagos
       completos (un anticipo puede cubrir varias ventas). #}
    {% set total_bruta = 0 %}
    {% set total_reconocida = 0 %}
    {% for line in lines %}
        {% set total_bruta = total_bruta + line.grossProfitLine %}
        {% set total_reconocida = total_reconocida + line.recognizedProfitLine %}
    {% endfor %}
    {% set pendiente = sale.totalAmount - total_pagado %}

    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <h1 class="text-2xl font-semibold text-foreground">
            Venta {{ sale.id }}
            <span class="ml-2 align-middle text-sm font-normal {{ sale.voidedAt ? 'text-danger' : 'text-muted' }}">
                {{ sale.voidedAt ? 'Anulada' : 'Activa' }}
            </span>
        </h1>
        <a href="{{ path('app_sale_index') }}" class="text-sm text-brand hover:underline">Volver al listado</a>
    </div>

    {% if sale.voidedAt %}
        <div id="venta-anulada" role="alert" class="mb-6 rounded border border-danger/30 bg-danger/5 px-4 py-3 text-sm text-danger">
            <p class="font-medium">Esta venta fue anulada y no cuenta para la recuperación de la inversión.</p>
            <p class="mt-1">
                Motivo: {{ sale.voidReason ?? 'Sin motivo registrado' }}
                · Anulada el {{ sale.voidedAt|date('d/m/Y') }}
                {% if sale.voidedBy %} por {{ sale.voidedBy.email }}{% endif %}
            </p>
        </div>
    {% endif %}

    <section aria-labelledby="titulos-cabecera" class="mb-10">
        <h2 id="titulos-cabecera" class="mb-4 text-lg font-medium text-foreground">Resumen</h2>
        <dl class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            <div class="rounded border border-border bg-surface p-4">
                <dt class="text-sm text-muted">Fecha</dt>
                <dd class="mt-1 text-foreground">{{ sale.saleDate|date('d/m/Y') }}</dd>
            </div>
            <div class="rounded border border-border bg-surface p-4">
                <dt class="text-sm text-muted">Cliente</dt>
                <dd class="mt-1 text-foreground">
                    {% if sale.customer %}
                        <a
                            href="{{ path('app_customer_show', {id: sale.customer.id}) }}"
                            class="text-brand hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand"
                        >{{ sale.customer.name }}</a>
                    {% else %}
                        Consumidor final
                    {% endif %}
                </dd>
            </div>
            <div class="rounded border border-border bg-surface p-4">
                <dt class="text-sm text-muted">Inversión</dt>
                <dd class="mt-1 text-foreground">
                    <a
                        href="{{ path('app_investment_show', {id: sale.investment.id}) }}"
                        class="text-brand hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand"
                    >{{ sale.investment.code }}</a>
                    {% if sale.investment.description %}
                        <span class="text-muted">· {{ sale.investment.description }}</span>
                    {% endif %}
                </dd>
            </div>
            <div class="rounded border border-border bg-surface p-4">
                <dt class="text-sm text-muted">Notas</dt>
                <dd class="mt-1 text-foreground">{{ sale.notes ?? '—' }}</dd>
            </div>
            <div class="rounded border border-border bg-surface p-4">
                <dt class="text-sm text-muted">Moneda</dt>
                <dd class="mt-1 text-foreground">{{ sale.currency }}</dd>
            </div>
        </dl>
    </section>

    <section aria-labelledby="titulos-totales" class="mb-10">
        <h2 id="titulos-totales" class="mb-4 text-lg font-medium text-foreground">Totales</h2>
        <dl class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            <div class="rounded border border-border bg-surface p-4">
                <dt class="text-sm text-muted">Total vendido</dt>
                <dd id="venta-total" class="mt-1 text-xl font-semibold text-foreground">{{ sale.totalAmount|number_format(2, ',', '.') }}</dd>
            </div>
            <div class="rounded border border-border bg-surface p-4">
                <dt class="text-sm text-muted">Ganancia bruta</dt>
                <dd id="venta-ganancia-bruta" class="mt-1 text-foreground">{{ total_bruta|number_format(2, ',', '.') }}</dd>
            </div>
            <div class="rounded border border-border bg-surface p-4">
                <dt class="text-sm text-muted">Ganancia reconocida</dt>
                <dd id="venta-ganancia-reconocida" class="mt-1 text-foreground">{{ total_reconocida|number_format(2, ',', '.') }}</dd>
            </div>
            <div class="rounded border border-border bg-surface p-4">
                <dt class="text-sm text-muted">Pagado</dt>
                <dd id="venta-pagado" class="mt-1 text-foreground">{{ total_pagado|number_format(2, ',', '.') }}</dd>
            </div>
            <div class="rounded border border-border bg-surface p-4">
                <dt class="text-sm text-muted">Pendiente</dt>
                <dd id="venta-pendiente" class="mt-1 text-foreground">{{ pendiente|number_format(2, ',', '.') }}</dd>
            </div>
        </dl>
    </section>

    <section aria-labelledby="titulos-lineas" class="mb-10">
        <h2 id="titulos-lineas" class="mb-4 text-lg font-medium text-foreground">Líneas</h2>
        {% if lines is empty %}
            <p class="rounded border border-border bg-surface px-4 py-3 text-sm text-muted">La venta no tiene líneas.</p>
        {% else %}
            <div class="overflow-x-auto rounded border border-border bg-surface">
                <table class="w-full text-sm">
                    <caption class="sr-only">Líneas de la venta {{ sale.id }}</caption>
                    <thead>
                        <tr class="border-b border-border text-start text-muted">
                            <th scope="col" class="px-4 py-2 text-start font-medium">Producto</th>
                            <th scope="col" class="px-4 py-2 text-end font-medium">Cantidad</th>
                            <th scope="col" class="px-4 py-2 text-end font-medium">Precio unitario</th>
                            <th scope="col" class="px-4 py-2 text-end font-medium">Subtotal</th>
                            <th scope="col" class="px-4 py-2 text-end font-medium">Costo unitario</th>
                            <th scope="col" class="px-4 py-2 text-end font-medium">Ganancia bruta</th>
                            <th scope="col" class="px-4 py-2 text-end font-medium">Ganancia reconocida</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for line in lines %}
                            <tr class="border-b border-border last:border-b-0">
                                <td class="px-4 py-2 font-medium text-foreground">{{ line.investmentItem.product.name }}</td>
                                <td class="px-4 py-2 text-end">{{ line.quantity }}</td>
                                <td class="px-4 py-2 text-end">{{ line.unitPrice|number_format(2, ',', '.') }}</td>
                                <td class="px-4 py-2 text-end">{{ line.totalLine|number_format(2, ',', '.') }}</td>
                                <td class="px-4 py-2 text-end">{{ line.realUnitCostSnapshot|number_format(2, ',', '.') }}</td>
                                <td class="px-4 py-2 text-end">{{ line.grossProfitLine|number_format(2, ',', '.') }}</td>
                                <td class="px-4 py-2 text-end">{{ line.recognizedProfitLine|number_format(2, ',', '.') }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>

    {% if not sale.voidedAt %}
        <section aria-labelledby="titulos-anular" class="mb-10">
            <h2 id="titulos-anular" class="mb-4 text-lg font-medium text-foreground">Anular venta</h2>
            <form action="{{ path('app_sale_void', {id: sale.id}) }}" method="post" class="space-y-4 rounded border border-danger/30 bg-surface p-4">
                <p class="text-sm text-muted">
                    Anular devuelve las unidades al inventario y saca la venta de la recuperación de la inversión.
                    Las ventas con pagos aplicados no se pueden anular.
                </p>
                <div>
                    <label for="void_reason" class="mb-1 block text-sm font-medium text-foreground">Motivo de la anulación</label>
                    <input
                        type="text"
                        id="void_reason"
                        name="reason"
                        maxlength="255"
                        required
                        class="w-full rounded border border-border bg-surface px-3 py-2 text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand"
                    >
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                <button
                    type="submit"
                    class="rounded border border-danger/40 bg-surface px-4 py-2 text-sm font-medium text-danger hover:bg-danger/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-danger"
                >Anular venta</button>
            </form>
        </section>
    {% endif %}

    <section aria-labelledby="titulos-pagos" class="mb-10">
        <div class="mb-4 flex flex-wrap items-center justify-between gap-4">
            <h2 id="titulos-pagos" class="text-lg font-medium text-foreground">Pagos</h2>
            {% if not sale.voidedAt %}
                <a
                    href="{{ path('app_payment_new_for_sale', {id: sale.id}) }}"
                    id="venta-registrar-pago"
                    class="rounded bg-brand px-4 py-2 text-sm font-medium text-white hover:bg-brand/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2"
                >Registrar pago</a>
            {% endif %}
        </div>
        {% if allocations is empty %}
            <p class="rounded border border-border bg-surface px-4 py-3 text-sm text-muted">Sin pagos registrados.</p>
        {% else %}
            <div class="overflow-x-auto rounded border border-border bg-surface">
                <table class="w-full text-sm">
                    <caption class="sr-only">Importes aplicados a la venta {{ sale.id }}</caption>
                    <thead>
                        <tr class="border-b border-border text-start text-muted">
                            <th scope="col" class="px-4 py-2 text-start font-medium">Fecha</th>
                            <th scope="col" class="px-4 py-2 text-start font-medium">Método</th>
                            <th scope="col" class="px-4 py-2 text-end font-medium">Aplicado</th>
                            <th scope="col" class="px-4 py-2 text-start font-medium">Referencia</th>
                            <th scope="col" class="px-4 py-2 text-start font-medium"><span class="sr-only">Detalle</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for allocation in allocations %}
                            <tr class="border-b border-border last:border-b-0">
                                <td class="px-4 py-2 text-foreground">{{ allocation.payment.paymentDate|date('d/m/Y') }}</td>
                                <td class="px-4 py-2">{{ method_labels[allocation.payment.method] ?? allocation.payment.method }}</td>
                                <td class="px-4 py-2 text-end">{{ allocation.amount|number_format(2, ',', '.') }}</td>
                                <td class="px-4 py-2">{{ allocation.payment.reference ?? '—' }}</td>
                                <td class="px-4 py-2">
                                    <a
                                        href="{{ path('app_payment_show', {id: allocation.payment.id}) }}"
                                        class="text-brand hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand"
                                    >Ver pago</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>

    {# Fase 3f / ADR-0018: un anticipo del cliente se reparte sobre la
       venta desde acá. Solo se pinta cuando hay remanente y la venta es
       activa de un cliente concreto: el controlador ya filtra ambos casos,
       pero el form se oculta también para no mostrar una acción inválida.
       El monto y el remanente los revalida el dominio (PaymentService),
       no el form. #}
    {% if not sale.voidedAt and available_advances is not empty %}
        <section aria-labelledby="titulos-anticipo" class="mb-10">
            <h2 id="titulos-anticipo" class="mb-4 text-lg font-medium text-foreground">Aplicar anticipo</h2>
            <form action="{{ path('app_payment_apply_to_sale', {id: sale.id}) }}" method="post" class="space-y-4 rounded border border-border bg-surface p-4">
                <p class="text-sm text-muted">
                    Repartí un anticipo de {{ sale.customer.name }} sobre esta venta. Cada anticipo puede usarse una sola
                    vez por cada venta, hasta agotar su remanente; el pendiente de la venta es
                    {{ pendiente|number_format(2, ',', '.') }}.
                </p>
                <div>
                    <label for="advance_payment" class="mb-1 block text-sm font-medium text-foreground">Anticipo</label>
                    <select
                        id="advance_payment"
                        name="payment"
                        required
                        class="w-full max-w-md rounded border border-border bg-surface px-3 py-2 text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand"
                    >
                        <option value="">Seleccioná un anticipo</option>
                        {% for advance in available_advances %}
                            <option value="{{ advance.payment.id }}">
                                Pago {{ advance.payment.id }} · {{ advance.payment.paymentDate|date('d/m/Y') }}
                                · disponible {{ advance.available|number_format(2, ',', '.') }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div>
                    <label for="advance_amount" class="mb-1 block text-sm font-medium text-foreground">Monto a aplicar</label>
                    <input
                        type="number"
                        id="advance_amount"
                        name="amount"
                        min="0"
                        step="0.01"
                        max="{{ pendiente }}"
                        required
                        class="w-40 rounded border border-border bg-surface px-3 py-2 text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand"
                    >
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                <button
                    type="submit"
                    class="rounded border border-brand/40 bg-surface px-4 py-2 text-sm font-medium text-brand hover:bg-brand/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand"
                >Aplicar anticipo</button>
            </form>
        </section>
    {% endif %}
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Iniciar sesión · Gestión de Negocio{% endblock %}

{% block body %}
    <div class="mx-auto w-full max-w-sm py-12">
        <div class="card p-6">
            <h1 class="heading-1 mb-2">Iniciar sesión</h1>
            <p class="muted-text mb-6">Bienvenido de nuevo. Iniciá sesión para continuar.</p>

            {% if error %}
                <p role="alert" class="alert alert-danger mb-4">No se pudo iniciar sesión con los datos proporcionados.</p>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}" class="space-y-5">
                <div>
                    <label for="email" class="form-label">Correo electrónico</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        value="{{ last_username }}"
                        required
                        autofocus
                        autocomplete="username"
                        class="input w-full"
                    >
                </div>

                <div>
                    <label for="password" class="form-label">Contraseña</label>
                    <input
                        type="password"
                        id="password"
                        name="password"
                        required
                        autocomplete="current-password"
                        class="input w-full"
                    >
                </div>

                <div class="flex items-center gap-2">
                    <input
                        type="checkbox"
                        id="remember_me"
                        name="_remember_me"
                        class="size-4 rounded border-border text-brand focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand"
                    >
                    <label for="remember_me" class="text-sm text-foreground">Mantener sesión iniciada</label>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="btn-primary w-full">Iniciar sesión</button>
            </form>
        </div>
    </div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Elegir negocio · Gestión de Negocio{% endblock %}

{% block body %}
    <div class="mx-auto w-full max-w-lg py-12">
        <h1 class="heading-1 mb-2">Elegí un negocio</h1>
        <p class="muted-text mb-6">
            Elegí con cuál de tus negocios querés trabajar. Podés cambiarlo cuando quieras desde el menú superior.
        </p>

        <ul class="space-y-3">
            {% for membership in memberships %}
                {% set tenant = membership.tenant %}
                <li>
                    <div
                        class="card p-4 flex items-center justify-between gap-4 {{ tenant.id == active_tenant_id ? 'ring-2 ring-brand' }}"
                    >
                        <div>
                            <div class="flex items-center gap-2">
                                <p class="heading-3">{{ tenant.name }}</p>
                                {% if tenant.id == active_tenant_id %}
                                    <span class="badge badge-success">Activo</span>
                                {% endif %}
                            </div>
                            <p class="small-text mt-0.5">
                                {{ tenant.slug }}
                                {% if membership.isDefault %}
                                    · negocio principal
                                {% endif %}
                            </p>
                        </div>

                        {% if tenant.id != active_tenant_id %}
                            <form method="post" action="{{ path('app_select_tenant_switch', { membershipId: membership.id }) }}">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('select_tenant') }}">
                                <button type="submit" class="btn-secondary">Entrar</button>
                            </form>
                        {% endif %}
                    </div>
                </li>
            {% endfor %}
        </ul>

        <p class="mt-6">
            <a href="{{ path('app_onboarding') }}" class="link">Crear un negocio nuevo</a>
        </p>
    </div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Crear negocio · Gestión de Negocio{% endblock %}

{% block body %}
    <div class="mx-auto w-full max-w-md py-12">
        <div class="card p-6">
            <h1 class="heading-1 mb-2">Creá tu negocio</h1>
            <p class="muted-text mb-6">
                Para empezar a registrar inversiones necesitás un negocio. Después podés crear más
                y alternar entre ellos cuando quieras.
            </p>

            {{ form_start(form, { attr: { class: 'space-y-5' } }) }}
                <div>
                    {{ form_label(form.name, null, { label_attr: { class: 'form-label' } }) }}
                    {{ form_widget(form.name, { attr: {
                        class: 'input w-full',
                        autofocus: true,
                    } }) }}
                    {{ form_errors(form.name, { error_attr: { class: 'form-error', role: 'alert' } }) }}
                </div>

                <div>
                    {{ form_label(form.slug, null, { label_attr: { class: 'form-label' } }) }}
                    {{ form_widget(form.slug, { attr: {
                        class: 'input w-full',
                        placeholder: 'ej: mi-negocio',
                    } }) }}
                    {% if form.slug.vars.help is defined and form.slug.vars.help %}
                        <p class="form-help">{{ form.slug.vars.help }}</p>
                    {% endif %}
                    {{ form_errors(form.slug, { error_attr: { class: 'form-error', role: 'alert' } }) }}
                </div>

                {{ form_rest(form) }}

                <button type="submit" class="btn-primary w-full">Crear negocio</button>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}

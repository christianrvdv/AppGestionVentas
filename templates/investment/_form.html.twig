{# Cabecera de inversión (fecha + descripción). Mismo patrón que
   product/_form.html.twig: label + input + help + error, y fila de
   acciones tras un divider (convención de Fase 3).

   investmentDate es DateType con widget single_text, así que renderiza un
   <input type="date">: input + w-full es todo lo que necesita.
   description es TextType (no TextareaType), así que también va con
   input + w-full; rows no aplicaría sin cambiar el HTML semántico. #}
{{ form_start(form, {attr: {class: 'space-y-6'}}) }}
    <div>
        <label for="{{ form.investmentDate.vars.id }}" class="form-label">{{ form.investmentDate.vars.label }}</label>
        {{ form_widget(form.investmentDate, {attr: {class: 'input w-full'}}) }}
        {% for error in form.investmentDate.vars.errors %}
            <p class="form-error" role="alert">{{ error.message }}</p>
        {% endfor %}
    </div>

    <div>
        <label for="{{ form.description.vars.id }}" class="form-label">{{ form.description.vars.label }}</label>
        {{ form_widget(form.description, {attr: {class: 'input w-full'}}) }}
        {% for error in form.description.vars.errors %}
            <p class="form-error" role="alert">{{ error.message }}</p>
        {% endfor %}
        <p class="form-help">La inversión nace en borrador (abierta y sin confirmar): podés agregar ítems y gastos y editarla todo ese tiempo. Al confirmarla se fijan los totales y deja de aceptar cambios.</p>
    </div>

    {{ form_rest(form) }}
    <hr class="divider">
    <div class="flex gap-3">
        <button type="submit" class="btn-primary">{{ submit_label|default('Guardar') }}</button>
        <a href="{{ cancel_url|default(path('app_investment_index')) }}" class="btn-secondary">Cancelar</a>
    </div>
{{ form_end(form) }}

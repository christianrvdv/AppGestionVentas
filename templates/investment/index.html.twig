{% extends 'base.html.twig' %}

{% block title %}Inversiones · Gestión de Negocio{% endblock %}

{% block body %}
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <h1 class="heading-1">Inversiones</h1>
        <a href="{{ path('app_investment_new') }}" class="btn-primary">Nueva inversión</a>
    </div>

    <form method="get" action="{{ path('app_investment_index') }}" class="mb-6 flex flex-wrap items-end gap-3">
        <div>
            <label for="status" class="form-label">Estado</label>
            <select id="status" name="status" class="input">
                <option value="">Todos</option>
                {% for value, label in status_labels %}
                    <option value="{{ value }}" {{ current_status == value ? 'selected' }}>{{ label }}</option>
                {% endfor %}
            </select>
        </div>
        {# "Nueva inversión" (cabecera) es la única primaria de la vista
           (DESIGN.md §8.7); Filtrar/Limpiar son acciones de la vista. #}
        <button type="submit" class="btn-secondary">Filtrar</button>
        {% if current_status %}
            <a href="{{ path('app_investment_index') }}" class="btn-ghost">Limpiar filtro</a>
        {% endif %}
    </form>

    {% if pagination.items is empty %}
        <div class="empty-state">
            {% if current_status %}
                No hay inversiones con el estado "{{ status_labels[current_status] ?? current_status }}".
                <a href="{{ path('app_investment_index') }}" class="link">Quitar filtro</a>.
            {% else %}
                Todavía no hay inversiones.
                <a href="{{ path('app_investment_new') }}" class="link">Crear la primera inversión</a>.
            {% endif %}
        </div>
    {% else %}
        <div class="overflow-x-auto rounded border border-border bg-surface">
            <table class="table">
                <caption class="sr-only">Listado de inversiones del negocio</caption>
                <thead>
                    <tr class="table-header">
                        <th scope="col" class="px-4 py-2 text-start font-medium">Código</th>
                        <th scope="col" class="px-4 py-2 text-start font-medium">Fecha</th>
                        <th scope="col" class="px-4 py-2 text-start font-medium">Estado</th>
                        <th scope="col" class="px-4 py-2 text-start font-medium">Descripción</th>
                        <th scope="col" class="px-4 py-2 text-end font-medium">Total</th>
                        <th scope="col" class="px-4 py-2 text-end font-medium"><span class="sr-only">Detalle</span></th>
                    </tr>
                </thead>
                <tbody>
                    {% for investment in pagination %}
                        {# Ámbar = en movimiento (abierta sin confirmar, recuperación
                           parcial); verde = recuperada; neutro = terminal tranquila
                           (cerrada); rojo = cancelada. El texto del badge es la fuente
                           de verdad; el color solo refuerza. #}
                        {% set badge_class = {
                            'OPEN': 'badge badge-warning',
                            'PARTIAL': 'badge badge-warning',
                            'RECOVERED': 'badge badge-success',
                            'CLOSED': 'badge',
                            'CANCELLED': 'badge badge-danger',
                        }[investment.status] ?? 'badge' %}
                        <tr class="table-row {{ investment.status in ['CLOSED', 'CANCELLED'] ? 'text-muted' : '' }}">
                            <td class="px-4 py-2 font-medium text-foreground">{{ investment.code }}</td>
                            <td class="px-4 py-2">{{ investment.investmentDate|date('d/m/Y') }}</td>
                            <td class="px-4 py-2">
                                <span class="{{ badge_class }}">{{ status_labels[investment.status] ?? investment.status }}</span>
                            </td>
                            <td class="px-4 py-2">{{ investment.description ?? '—' }}</td>
                            <td class="px-4 py-2 text-end tabular-nums">{{ investment.liveTotalInvestment|number_format(2, ',', '.') }}</td>
                            <td class="px-4 py-2 text-end">
                                <a href="{{ path('app_investment_show', {id: investment.id}) }}" class="link">Ver</a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <nav aria-label="Paginación de inversiones" class="mt-4">
            {{ knp_pagination_render(pagination) }}
        </nav>
    {% endif %}
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Registrar tasa USD · Gestión de Negocio{% endblock %}

{% block body %}
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <h1 class="heading-1">Registrar tasa USD</h1>
        <a href="{{ path('app_usd_rate_index') }}" class="link">Volver al listado</a>
    </div>

    {{ form_start(form, {attr: {class: 'card p-6 mx-auto max-w-md space-y-6'}}) }}
        {# Errores de dominio (p. ej. fallo de tenant) que el controller
           añade a la raíz del form; los de campo se pintan más abajo. #}
        {% for error in form.vars.errors %}
            <p class="form-error" role="alert">{{ error.message }}</p>
        {% endfor %}

        <div>
            <label for="{{ form.rateDate.vars.id }}" class="form-label">{{ form.rateDate.vars.label }}</label>
            {{ form_widget(form.rateDate, {attr: {class: 'input'}}) }}
            {% for error in form.rateDate.vars.errors %}
                <p class="form-error" role="alert">{{ error.message }}</p>
            {% endfor %}
        </div>

        <div>
            <label for="{{ form.rate.vars.id }}" class="form-label">{{ form.rate.vars.label }}</label>
            {{ form_widget(form.rate, {attr: {class: 'input'}}) }}
            {% for error in form.rate.vars.errors %}
                <p class="form-error" role="alert">{{ error.message }}</p>
            {% endfor %}
            <p class="form-help">Formato esperado: 9999.9999 (4 decimales). Ej: 350.5000</p>
        </div>

        <div>
            <label for="{{ form.note.vars.id }}" class="form-label">{{ form.note.vars.label }}</label>
            {{ form_widget(form.note, {attr: {class: 'input'}}) }}
            {% for error in form.note.vars.errors %}
                <p class="form-error" role="alert">{{ error.message }}</p>
            {% endfor %}
        </div>

        <hr class="divider">
        <div class="flex gap-3">
            <button type="submit" class="btn-primary">Guardar tasa</button>
            <a href="{{ path('app_usd_rate_index') }}" class="btn-secondary">Cancelar</a>
        </div>
    {{ form_end(form) }}

    <div class="card mt-6">
        <h2 class="heading-3">Correcciones encadenadas</h2>
        <p class="muted-text mt-1">
            Si ya existe una tasa para la fecha seleccionada, el sistema no la sobrescribe: crea una corrección encadenada que referencia a la tasa anterior. La tasa vigente siempre es la última insertada, y el historial completo se preserva para auditoría.
        </p>
    </div>
{% endblock %}

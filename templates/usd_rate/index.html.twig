{% extends 'base.html.twig' %}

{% block title %}Tasas USD · Gestión de Negocio{% endblock %}

{% block body %}
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <h1 class="heading-1">Tasas USD</h1>
        <a href="{{ path('app_usd_rate_new') }}" class="btn-primary">Registrar tasa</a>
    </div>

    <form method="get" action="{{ path('app_usd_rate_index') }}" class="mb-6 flex flex-wrap items-end gap-3">
        <div>
            <label for="from" class="form-label">Desde</label>
            <input type="date" id="from" name="from" value="{{ filter_from ?? '' }}" class="input">
        </div>
        <div>
            <label for="to" class="form-label">Hasta</label>
            <input type="date" id="to" name="to" value="{{ filter_to ?? '' }}" class="input">
        </div>
        {# "Registrar tasa" (header) es la única primaria de la vista
           (DESIGN.md §8.7); Filtrar/Limpiar son acciones de la vista. #}
        <button type="submit" class="btn-secondary">Filtrar</button>
        {% if filter_from or filter_to %}
            <a href="{{ path('app_usd_rate_index') }}" class="btn-ghost">Limpiar filtro</a>
        {% endif %}
    </form>

    {% if pagination.items is empty %}
        <div class="empty-state">
            No hay tasas registradas.
            <a href="{{ path('app_usd_rate_new') }}" class="link">Registra la primera</a>.
        </div>
    {% else %}
        <div class="overflow-x-auto rounded border border-border bg-surface">
            <table class="table">
                <caption class="sr-only">Listado de tasas USD del negocio</caption>
                <thead>
                    <tr class="table-header">
                        <th scope="col" class="px-4 py-2 text-start font-medium">Fecha</th>
                        <th scope="col" class="px-4 py-2 text-start font-medium">Tasa</th>
                        <th scope="col" class="px-4 py-2 text-start font-medium">Corrección</th>
                        <th scope="col" class="px-4 py-2 text-start font-medium">Supersede a</th>
                        <th scope="col" class="px-4 py-2 text-start font-medium">Registrado por</th>
                        <th scope="col" class="px-4 py-2 text-start font-medium">Cuándo</th>
                        <th scope="col" class="px-4 py-2 text-start font-medium">Nota</th>
                    </tr>
                </thead>
                <tbody>
                    {% for rate in pagination %}
                        <tr class="table-row {% if rate.id == current_rate_id %}bg-brand/5{% endif %}">
                            <td class="px-4 py-2 font-medium text-foreground">
                                {{ rate.rateDate|date('d/m/Y') }}
                                {% if rate.id == current_rate_id %}
                                    <span class="badge badge-success ms-2">Vigente</span>
                                {% endif %}
                            </td>
                            <td class="px-4 py-2 tabular-nums text-foreground">{{ rate.rate|number_format(4, ',', '.') }}</td>
                            <td class="px-4 py-2 text-start">
                                {% if rate.isCorrection %}
                                    <span class="badge badge-warning" aria-label="Esta tasa es una corrección de una tasa anterior para la misma fecha">
                                        <svg class="me-1 h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                                        Corrección
                                    </span>
                                {% else %}
                                    <span class="muted-text">No</span>
                                {% endif %}
                            </td>
                            <td class="px-4 py-2 text-start">
                                {% if rate.supersedes %}
                                    <span class="muted-text tabular-nums">
                                        {{ rate.supersedes.rateDate|date('d/m/Y') }} ({{ rate.supersedes.rate|number_format(4, ',', '.') }})
                                    </span>
                                {% else %}
                                    <span class="muted-text">—</span>
                                {% endif %}
                            </td>
                            <td class="px-4 py-2 text-start">
                                {% if rate.createdBy %}
                                    {{ rate.createdBy.email }}
                                {% else %}
                                    <span class="muted-text">Sistema</span>
                                {% endif %}
                            </td>
                            <td class="px-4 py-2 text-start">{{ rate.createdAt|date('d/m/Y H:i') }}</td>
                            <td class="px-4 py-2 text-start">{{ rate.sourceNote ?? '—' }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <nav aria-label="Paginación de tasas USD" class="mt-4">
            {{ knp_pagination_render(pagination) }}
        </nav>
    {% endif %}
{% endblock %}

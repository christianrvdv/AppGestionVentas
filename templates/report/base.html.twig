{% extends 'base.html.twig' %}

{% block title %}{{ title|default('Reportes') }} - Gestión de Negocio{% endblock %}

{% block body %}
    <div class="mb-6">
        <h1 class="text-2xl font-semibold text-foreground">{{ title|default('Reporte') }}</h1>
        <p class="text-muted text-sm mt-1">{{ description|default('Visualización de datos del negocio') }}</p>
    </div>

    {% block filters %}
        <div class="mb-6 rounded border bg-surface p-4">
            <form method="get" class="flex flex-wrap items-end gap-4" novalidate>
                {% block filter_fields %}{% endblock %}
                <button type="submit" class="btn-primary">Filtrar</button>
                <a href="{{ request.getRequestUri|split('?')[0] }}" class="btn-secondary">Limpiar</a>
            </form>
        </div>
    {% endblock %}

    {% block content %}{% endblock %}
{% endblock %}
{% extends 'report/base.html.twig' %}

{% set title = 'Impacto de Revaluación USD' %}
{% set description = 'Historial de revaluaciones de costos por cambio de tasa USD' %}

{% block filter_fields %}
    <div>
        <label for="from" class="block text-xs font-medium text-muted mb-1">Desde</label>
        <input type="date" id="from" name="from" value="{{ filters.from ? filters.from.format('Y-m-d') : '' }}" class="input-sm">
    </div>
    <div>
        <label for="to" class="block text-xs font-medium text-muted mb-1">Hasta</label>
        <input type="date" id="to" name="to" value="{{ filters.to ? filters.to.format('Y-m-d') : '' }}" class="input-sm">
    </div>
{% endblock %}

{% block content %}
    {# Resumen total #}
    <div class="mb-6 rounded border border-border bg-surface p-4">
        <div class="flex flex-wrap items-center justify-between gap-4">
            <div>
                <p class="text-sm text-muted">Ganancia/Pérdida latente total del período</p>
                <p class="text-2xl font-semibold {% if total_gain_loss > 0 %}text-danger{% elseif total_gain_loss < 0 %}text-success{% else %}text-foreground{% endif %} tabular-nums">
                    {% if total_gain_loss > 0 %}+{% endif %}{{ total_gain_loss|number_format(2, ',', '.') }}
                </p>
            </div>
            <div class="text-right text-sm text-muted">
                <p>Inversiones afectadas: {{ totals_by_investment|length }}</p>
                <p>Revaluaciones: {{ revaluations|length }}</p>
            </div>
        </div>
    </div>

    {# Tabla de revaluaciones #}
    {% if revaluations is empty %}
        <p class="rounded border border-border bg-surface px-4 py-3 text-sm text-muted text-center">
            Sin revaluaciones en el período seleccionado.
        </p>
    {% else %}
        <div class="overflow-x-auto rounded border border-border bg-surface">
            <table class="w-full text-sm">
                <caption class="sr-only">Detalle de revaluaciones de costos</caption>
                <thead>
                    <tr class="border-b border-border text-start text-muted">
                        <th scope="col" class="px-4 py-2 text-start font-medium">Fecha</th>
                        <th scope="col" class="px-4 py-2 text-start font-medium">Inversión</th>
                        <th scope="col" class="px-4 py-2 text-start font-medium">Ítem</th>
                        <th scope="col" class="px-4 py-2 text-end font-medium">Tasa anterior</th>
                        <th scope="col" class="px-4 py-2 text-end font-medium">Tasa nueva</th>
                        <th scope="col" class="px-4 py-2 text-end font-medium">Costo anterior</th>
                        <th scope="col" class="px-4 py-2 text-end font-medium">Costo nuevo</th>
                        <th scope="col" class="px-4 py-2 text-end font-medium">Delta (G/P)</th>
                        <th scope="col" class="px-4 py-2 text-end font-medium">Qty snapshot</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border">
                    {% for rev in revaluations %}
                        <tr class="hover:bg-muted/30">
                            <td class="px-4 py-3 text-foreground">{{ rev.createdAt|date('d/m/Y H:i') }}</td>
                            <td class="px-4 py-3 text-foreground">
                                <a href="{{ path('app_investment_show', {id: rev.investmentItem.investment.id}) }}" class="hover:underline">{{ rev.investmentItem.investment.code }}</a>
                            </td>
                            <td class="px-4 py-3 text-foreground">{{ rev.investmentItem.product.name }}</td>
                            <td class="px-4 py-3 text-end tabular-nums">{{ rev.oldRate|number_format(4, ',', '.') }}</td>
                            <td class="px-4 py-3 text-end tabular-nums">{{ rev.newRate|number_format(4, ',', '.') }}</td>
                            <td class="px-4 py-3 text-end tabular-nums">{{ rev.oldRealUnitCost|number_format(2, ',', '.') }}</td>
                            <td class="px-4 py-3 text-end tabular-nums">{{ rev.newRealUnitCost|number_format(2, ',', '.') }}</td>
                            <td class="px-4 py-3 text-end tabular-nums {% if rev.revaluationGainLoss > 0 %}text-danger{% elseif rev.revaluationGainLoss < 0 %}text-success{% endif %} font-medium">
                                {% if rev.revaluationGainLoss > 0 %}+{% endif %}{{ rev.revaluationGainLoss|number_format(2, ',', '.') }}
                            </td>
                            <td class="px-4 py-3 text-end tabular-nums">{{ rev.quantitySnapshot }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {# Totales por inversión #}
        {% if totals_by_investment|length > 1 %}
            <div class="mt-6 rounded border border-border bg-surface">
                <h3 class="px-4 py-3 text-lg font-medium text-foreground border-b border-border">Totales por inversión</h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="border-b border-border text-start text-muted">
                                <th scope="col" class="px-4 py-2 text-start font-medium">Inversión</th>
                                <th scope="col" class="px-4 py-2 text-end font-medium">Ganancia/Pérdida latente</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-border">
                            {% for data in totals_by_investment %}
                                <tr class="hover:bg-muted/30">
                                    <td class="px-4 py-3 text-foreground">
                                        <a href="{{ path('app_investment_show', {id: data.investment.id}) }}" class="hover:underline">{{ data.investment.code }}</a>
                                    </td>
                                    <td class="px-4 py-3 text-end tabular-nums {% if data.total_gain_loss > 0 %}text-danger{% elseif data.total_gain_loss < 0 %}text-success{% endif %} font-medium">
                                        {% if data.total_gain_loss > 0 %}+{% endif %}{{ data.total_gain_loss|number_format(2, ',', '.') }}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% endif %}
    {% endif %}
{% endblock %}
{% extends 'report/base.html.twig' %}

{% set title = 'Estado de Inversiones' %}
{% set description = 'Recuperación, ganancia reconocida y pendiente por inversión' %}

{% block filter_fields %}
    <div>
        <label for="status" class="block text-xs font-medium text-muted mb-1">Estado</label>
        <select id="status" name="status" class="input-sm">
            <option value="">Todos</option>
            {% for key, label in statusLabels %}
                <option value="{{ key }}" {% if key == filters.status %}selected{% endif %}>{{ label }}</option>
            {% endfor %}
        </select>
    </div>
    <div>
        <label for="from" class="block text-xs font-medium text-muted mb-1">Desde</label>
        <input type="date" id="from" name="from" value="{{ filters.from ? filters.from.format('Y-m-d') : '' }}" class="input-sm">
    </div>
    <div>
        <label for="to" class="block text-xs font-medium text-muted mb-1">Hasta</label>
        <input type="date" id="to" name="to" value="{{ filters.to ? filters.to.format('Y-m-d') : '' }}" class="input-sm">
    </div>
    <div>
        <label for="sortBy" class="block text-xs font-medium text-muted mb-1">Ordenar por</label>
        <select id="sortBy" name="sortBy" class="input-sm">
            {% for key, label in sortOptions.fields %}
                <option value="{{ key }}" {% if key == filters.sortBy %}selected{% endif %}>{{ label }}</option>
            {% endfor %}
        </select>
    </div>
    <div>
        <label for="sortDir" class="block text-xs font-medium text-muted mb-1">Dirección</label>
        <select id="sortDir" name="sortDir" class="input-sm">
            {% for key, label in sortOptions.directions %}
                <option value="{{ key }}" {% if key == filters.sortDir %}selected{% endif %}>{{ label }}</option>
            {% endfor %}
        </select>
    </div>
{% endblock %}

{% block content %}
    <div class="overflow-x-auto rounded border">
        <table class="w-full text-sm">
            <thead class="bg-muted/50">
                <tr>
                    <th class="px-4 py-3 text-left font-medium text-foreground">Código</th>
                    <th class="px-4 py-3 text-left font-medium text-foreground">Fecha</th>
                    <th class="px-4 py-3 text-center font-medium text-foreground">Estado</th>
                    <th class="px-4 py-3 text-right font-medium text-foreground">Total Invertido</th>
                    <th class="px-4 py-3 text-right font-medium text-foreground">Total Recuperado</th>
                    <th class="px-4 py-3 text-center font-medium text-foreground">% Recuperación</th>
                    <th class="px-4 py-3 text-right font-medium text-foreground">Ganancia Reconocida</th>
                    <th class="px-4 py-3 text-right font-medium text-foreground">Pendiente</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-border">
                {% for row in rows %}
                    <tr class="hover:bg-muted/30">
                        <td class="px-4 py-3 font-mono text-foreground">{{ row.investment.code }}</td>
                        <td class="px-4 py-3 text-foreground">{{ row.investment.investmentDate.format('d/m/Y') }}</td>
                        <td class="px-4 py-3 text-center">
                            <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium
                                {% set status = row.investment.status %}
                                {% if status == 'OPEN' %}bg-blue-100 text-blue-800
                                {% elseif status == 'PARTIAL' %}bg-yellow-100 text-yellow-800
                                {% elseif status == 'RECOVERED' %}bg-green-100 text-green-800
                                {% elseif status == 'CLOSED' %}bg-gray-100 text-gray-800
                                {% elseif status == 'CANCELLED' %}bg-red-100 text-red-800
                                {% endif %}">
                                {{ statusLabels[row.investment.status] }}
                            </span>
                        </td>
                        <td class="px-4 py-3 text-right tabular-nums text-foreground">{{ row.summary.totalInvestment|number_format(2, ',', '.') }}</td>
                        <td class="px-4 py-3 text-right tabular-nums text-success">{{ row.summary.totalRecovered|number_format(2, ',', '.') }}</td>
                        <td class="px-4 py-3 text-center">
                            <div class="w-32 mx-auto">
                                <div class="h-2 rounded-full bg-muted overflow-hidden">
                                    <div class="h-full {{ row.progressClass }} transition-all duration-300" style="width: {{ row.recoveryPct > 100 ? 100 : row.recoveryPct }}%"></div>
                                </div>
                                <span class="text-xs text-muted">{{ row.recoveryPct|number_format(2, ',', '.') }}%</span>
                            </div>
                        </td>
                        <td class="px-4 py-3 text-right tabular-nums text-primary">{{ row.summary.totalRecognizedProfit|number_format(2, ',', '.') }}</td>
                        <td class="px-4 py-3 text-right tabular-nums
                            {% if row.summary.totalPending > 0 %}text-warning{% else %}text-success{% endif %}">
                            {{ row.summary.totalPending|number_format(2, ',', '.') }}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8" class="px-4 py-8 text-center text-muted">Sin inversiones para los filtros seleccionados</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
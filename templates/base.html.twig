<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Gestión de Negocio{% endblock %}</title>
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="min-h-screen bg-background font-sans text-foreground antialiased">
        <a
            href="#contenido"
            class="sr-only rounded focus:not-sr-only focus:absolute focus:start-4 focus:top-4 focus:z-50 focus:bg-surface focus:px-4 focus:py-2 focus:text-brand focus:ring-2 focus:ring-brand"
        >Saltar al contenido principal</a>

        {# Impersonation de tenant (Fase 6.2, ADR-0019): ver parcial. #}
        {% include '_partials/_impersonation_banner.html.twig' %}

        {# Orquestador de layout (SPEC-sidebar-navegacion): sidebar + topbar
           solo existen autenticado; main es único para ambos caminos. El
           controlador sidebar orquesta colapso (desktop) y cajón móvil. #}
        <div class="flex min-h-screen"{% if app.user %} data-controller="sidebar"{% endif %}>
            {% if app.user %}
                {% include '_partials/_sidebar.html.twig' %}
            {% endif %}

            <div class="flex min-w-0 flex-1 flex-col">
                {% if app.user %}
                    {% include '_partials/_topbar.html.twig' %}
                {% endif %}

                <main id="contenido" class="mx-auto w-full max-w-6xl px-4 py-8">
                    {# Cada tipo de flash pinta su propia alerta (DESIGN.md §7).
                       Antes un warning caía en la rama success y se veía verde. #}
                    {% set flash_alert = {
                        'success': 'alert alert-success',
                        'warning': 'alert alert-warning',
                        'danger': 'alert alert-danger',
                        'error': 'alert alert-danger',
                        'info': 'alert',
                    } %}
                    {% for type, messages in app.flashes %}
                        <div
                            role="{{ type in ['danger', 'error'] ? 'alert' : 'status' }}"
                            class="mb-6 {{ flash_alert[type] ?? 'alert' }}"
                        >
                            {% for message in messages %}
                                <p>{{ message }}</p>
                            {% endfor %}
                        </div>
                    {% endfor %}

                    {% block body %}{% endblock %}
                </main>
            </div>
        </div>

        {% block scripts %}{% endblock %}
    </body>
</html>

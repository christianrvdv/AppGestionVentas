<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Gestión de Negocio{% endblock %}</title>
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="min-h-screen bg-background font-sans text-foreground antialiased">
        <a
            href="#contenido"
            class="sr-only rounded focus:not-sr-only focus:absolute focus:start-4 focus:top-4 focus:z-50 focus:bg-surface focus:px-4 focus:py-2 focus:text-brand focus:ring-2 focus:ring-brand"
        >Saltar al contenido principal</a>

        {% if app.user %}
            <header class="border-b border-border bg-surface">
                <nav
                    aria-label="Navegación principal"
                    class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3"
                >
                    <a
                        href="{{ path('app_dashboard') }}"
                        class="text-base font-semibold text-foreground"
                    >Gestión de Negocio</a>

                    <ul class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm">
                        <li>
                            <a
                                href="{{ path('app_dashboard') }}"
                                class="{{ app.request.attributes.get('_route') == 'app_dashboard' ? 'font-semibold text-brand' : 'text-foreground hover:text-brand' }}"
                            >Dashboard</a>
                        </li>
                        <li>
                            <a
                                href="{{ path('app_investment_index') }}"
                                class="{{ app.request.attributes.get('_route') starts with 'app_investment_' ? 'font-semibold text-brand' : 'text-foreground hover:text-brand' }}"
                            >Inversiones</a>
                        </li>
                        <li>
                            <a
                                href="{{ path('app_sale_index') }}"
                                class="{{ app.request.attributes.get('_route') starts with 'app_sale_' ? 'font-semibold text-brand' : 'text-foreground hover:text-brand' }}"
                            >Ventas</a>
                        </li>
                        <li>
                            <a
                                href="{{ path('app_payment_index') }}"
                                class="{{ app.request.attributes.get('_route') starts with 'app_payment_' ? 'font-semibold text-brand' : 'text-foreground hover:text-brand' }}"
                            >Pagos</a>
                        </li>
                        <li>
                            <a
                                href="{{ path('app_product_index') }}"
                                class="{{ app.request.attributes.get('_route') starts with 'app_product_' ? 'font-semibold text-brand' : 'text-foreground hover:text-brand' }}"
                            >Productos</a>
                        </li>
                        <li>
                            <a
                                href="{{ path('app_customer_index') }}"
                                class="{{ app.request.attributes.get('_route') starts with 'app_customer_' ? 'font-semibold text-brand' : 'text-foreground hover:text-brand' }}"
                            >Clientes</a>
                        </li>
                        <li><span aria-disabled="true" class="cursor-not-allowed text-muted">Reportes</span></li>
                        <li><span aria-disabled="true" class="cursor-not-allowed text-muted">Configuración</span></li>
                    </ul>

                    <div class="ms-auto flex flex-wrap items-center gap-x-4 gap-y-1">
                        <a
                            href="{{ path('app_select_tenant') }}"
                            class="text-sm text-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand"
                            title="Cambiar de negocio"
                        >
                            <span class="text-xs uppercase tracking-wide">Negocio</span>
                            <span class="font-medium text-foreground">{{ active_tenant.name ?? 'Sin negocio' }}</span>
                        </a>

                        <form
                            action="{{ path('_logout_main') }}"
                            method="post"
                        >
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                            <button
                                type="submit"
                                class="text-sm text-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand"
                            >Cerrar sesión</button>
                        </form>
                    </div>
                </nav>
            </header>
        {% endif %}

        <main id="contenido" class="mx-auto max-w-6xl px-4 py-8">
            {% for type, messages in app.flashes %}
                <div
                    role="{{ type == 'error' ? 'alert' : 'status' }}"
                    class="mb-6 rounded border px-4 py-3 text-sm {{ type == 'error' ? 'border-danger/30 bg-danger/10 text-danger' : 'border-success/30 bg-success/10 text-success' }}"
                >
                    {% for message in messages %}
                        <p>{{ message }}</p>
                    {% endfor %}
                </div>
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        {% block scripts %}{% endblock %}
    </body>
</html>

<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Gestión de Negocio{% endblock %}</title>
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="min-h-screen bg-background font-sans text-foreground antialiased">
        <a
            href="#contenido"
            class="sr-only rounded focus:not-sr-only focus:absolute focus:start-4 focus:top-4 focus:z-50 focus:bg-surface focus:px-4 focus:py-2 focus:text-brand focus:ring-2 focus:ring-brand"
        >Saltar al contenido principal</a>

        {# Impersonation de tenant (Fase 6.2, ADR-0019): la marca vive en la
           sesión, así que el banner se ve en TODAS las páginas. El nombre
           sale de active_tenant, que durante el impersonation es el negocio
           impersonado (TenantFilterListener lo deja en TenantContext). #}
        {% if impersonation.isActive %}
            <div
                id="banner-impersonation"
                role="status"
                class="border-b border-warning/40 bg-warning/10 px-4 py-2 text-sm text-foreground"
            >
                <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-2">
                    <p>
                        Viendo como <strong>{{ active_tenant.name ?? 'negocio desconocido' }}</strong>
                        en modo soporte. Los cambios que hagas son reales para ese negocio.
                    </p>
                    <form
                        id="form-impersonate-stop"
                        method="post"
                        action="{{ path('app_admin_impersonate_stop') }}"
                    >
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_impersonate_stop') }}">
                        <button
                            type="submit"
                            class="rounded border border-warning/50 px-3 py-1 font-medium text-foreground hover:bg-warning/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand"
                        >Salir del modo soporte</button>
                    </form>
                </div>
            </div>
        {% endif %}

        {# Orquestador de layout (SPEC-sidebar-navegacion): sidebar + topbar
           solo existen autenticado; main es único para ambos caminos. El
           controlador sidebar orquesta colapso (desktop) y cajón móvil. #}
        <div class="flex min-h-screen"{% if app.user %} data-controller="sidebar"{% endif %}>
            {% if app.user %}
                {% include '_partials/_sidebar.html.twig' %}
            {% endif %}

            <div class="flex min-w-0 flex-1 flex-col">
                {% if app.user %}
                    {% include '_partials/_topbar.html.twig' %}
                {% endif %}

                <main id="contenido" class="mx-auto w-full max-w-6xl px-4 py-8">
                    {% for type, messages in app.flashes %}
                        <div
                            role="{{ type == 'error' ? 'alert' : 'status' }}"
                            class="mb-6 rounded border px-4 py-3 text-sm {{ type == 'error' ? 'border-danger/30 bg-danger/10 text-danger' : 'border-success/30 bg-success/10 text-success' }}"
                        >
                            {% for message in messages %}
                                <p>{{ message }}</p>
                            {% endfor %}
                        </div>
                    {% endfor %}

                    {% block body %}{% endblock %}
                </main>
            </div>
        </div>

        {% block scripts %}{% endblock %}
    </body>
</html>

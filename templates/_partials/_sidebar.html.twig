{% from '_partials/_nav_item.html.twig' import nav_item %}

{% set route = app.request.attributes.get('_route') %}
{% set icons = {
    dashboard: 'M3 3h7v9H3zM14 3h7v5h-7zM14 12h7v9h-7zM3 16h7v5H3z',
    investment: 'M16 7h6v6M22 7l-8.5 8.5-5-5L2 17',
    sale: 'M2 3h2l1.6 8.4a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 2-1.6L21 6H5M10 20a1 1 0 1 1-2 0 1 1 0 1 1 2 0M19 20a1 1 0 1 1-2 0 1 1 0 1 1 2 0',
    payment: 'M3 6h18a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1zM2 10h20',
    product: 'M21 8.5v7L12 21l-9-5.5v-7L12 3l9 5.5zM3 8.5l9 5.5 9-5.5M12 14v7',
    customer: 'M16 7a4 4 0 1 1-8 0 4 4 0 1 1 8 0M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1',
    dollar: 'M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6',
    chart: 'M3 3v18h18M7 17v-6M12 17v-10M17 17v-4',
    refresh: 'M21 12a9 9 0 1 1-3-6.7M21 3v6h-6',
    sliders: 'M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M2 14h4M10 8h4M18 16h4',
} %}

<aside
    id="sidebar-panel"
    data-sidebar-target="panel"
    class="flex h-screen shrink-0 flex-col border-e border-border bg-surface md:sticky md:top-0 md:w-64 md:transition-[width] md:duration-200"
>
    <div class="flex h-14 shrink-0 items-center border-b border-border px-3">
        <button
            type="button"
            class="btn-ghost md:hidden"
            aria-label="Navegación"
            aria-expanded="false"
            aria-controls="sidebar-panel"
            data-sidebar-target="toggle"
            data-sidebar-toggle="open"
            data-action="sidebar#close"
        >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
        <button
            type="button"
            class="btn-ghost ms-auto hidden md:inline-flex"
            aria-label="Barra lateral"
            aria-expanded="true"
            aria-controls="sidebar-panel"
            data-sidebar-target="toggle"
            data-sidebar-toggle="collapse"
            data-action="click->sidebar#toggleCollapse"
        >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m15 18-6-6 6-6"/></svg>
        </button>
    </div>

    <nav aria-label="Navegación principal" class="flex-1 overflow-y-auto px-2 pb-4">
        <h2 id="nav-grupo-operacion" class="sidebar-group-label px-3 pt-4 pb-1 text-xs font-semibold uppercase tracking-wide text-muted">Operación</h2>
        <ul aria-labelledby="nav-grupo-operacion" class="space-y-0.5">
            {{ nav_item(path('app_dashboard'), 'Dashboard', icons.dashboard, route == 'app_dashboard') }}
            {{ nav_item(path('app_investment_index'), 'Inversiones', icons.investment, route starts with 'app_investment_') }}
            {{ nav_item(path('app_sale_index'), 'Ventas', icons.sale, route starts with 'app_sale_') }}
            {{ nav_item(path('app_payment_index'), 'Pagos', icons.payment, route starts with 'app_payment_') }}
        </ul>

        <h2 id="nav-grupo-catalogo" class="sidebar-group-label px-3 pt-5 pb-1 text-xs font-semibold uppercase tracking-wide text-muted">Catálogo</h2>
        <ul aria-labelledby="nav-grupo-catalogo" class="space-y-0.5">
            {{ nav_item(path('app_product_index'), 'Productos', icons.product, route starts with 'app_product_') }}
            {{ nav_item(path('app_customer_index'), 'Clientes', icons.customer, route starts with 'app_customer_') }}
            {{ nav_item(path('app_usd_rate_index'), 'Tasas USD', icons.dollar, route starts with 'app_usd_rate_') }}
        </ul>

        <h2 id="nav-grupo-reportes" class="sidebar-group-label px-3 pt-5 pb-1 text-xs font-semibold uppercase tracking-wide text-muted">Reportes</h2>
        <ul aria-labelledby="nav-grupo-reportes" class="space-y-0.5">
            {{ nav_item(path('app_report_profit'), 'Ganancias', icons.chart, route == 'app_report_profit') }}
            {{ nav_item(path('app_report_investment'), 'Inversiones', icons.investment, route == 'app_report_investment') }}
            {{ nav_item(path('app_report_product'), 'Productos', icons.product, route == 'app_report_product') }}
            {{ nav_item(path('app_report_revaluation'), 'Revaluación USD', icons.refresh, route == 'app_report_revaluation') }}
        </ul>

        <h2 id="nav-grupo-sistema" class="sidebar-group-label px-3 pt-5 pb-1 text-xs font-semibold uppercase tracking-wide text-muted">Sistema</h2>
        <ul aria-labelledby="nav-grupo-sistema" class="space-y-0.5">
            {{ nav_item(path('app_settings_index'), 'Configuración', icons.sliders, route starts with 'app_settings_') }}
        </ul>
    </nav>
</aside>

<div
    id="sidebar-overlay"
    data-sidebar-target="overlay"
    data-action="sidebar#close"
    class="fixed inset-0 z-30 hidden bg-foreground/40 md:hidden"
    aria-hidden="true"
></div>
